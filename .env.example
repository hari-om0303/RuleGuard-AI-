# RuleGuard AI Configuration

# LLM API Settings (Optional - fallback extractive engine runs automatically if unset)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
USE_LLM_API=false

# Embedding API Settings (Optional - local TF-IDF cosine index runs automatically if unset)
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
